# Large test preset: about 30-50 jobs
# Use this for quota exhaustion and same-run retry stress testing

JOBS_PER_KEYWORD=1
CRAWL_CAREERVIET_JOBS=4
CRAWL_ITVIEC_JOBS=2
CRAWL_LINKEDIN_JOBS=4
CRAWL_VIETNAMWORKS_JOBS=2

TIER1_NUM_KEYWORDS=4
TIER1_SELECTION_METHOD=random
TIER2_NUM_KEYWORDS=2
TIER2_SELECTION_METHOD=sequential
TIER3_NUM_KEYWORDS=1
TIER3_SELECTION_METHOD=sequential

CRAWL_PARALLEL_CRAWLERS=3
CRAWL_DELAY_MIN=0.5
CRAWL_DELAY_MAX=1.5
CRAWL_MAX_RETRIES=2

PIPELINE_CRAWL=true
PIPELINE_CLEAN=true
PIPELINE_IMPORT=false

ETL_CLEAN_BATCH_SIZE=20
ETL_MAX_THREADS=12
ETL_CONFIDENCE_THRESHOLD=0.0
SKIP_NORMALIZE=true
GEMINI_RPM=4
