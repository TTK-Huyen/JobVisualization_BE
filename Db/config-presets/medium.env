# Medium test preset: about 10-20 jobs
# Use this for retry, rotate-key, and batch flow testing

JOBS_PER_KEYWORD=1
CRAWL_CAREERVIET_JOBS=2
CRAWL_ITVIEC_JOBS=1
CRAWL_LINKEDIN_JOBS=2
CRAWL_VIETNAMWORKS_JOBS=1

TIER1_NUM_KEYWORDS=2
TIER1_SELECTION_METHOD=random
TIER2_NUM_KEYWORDS=1
TIER2_SELECTION_METHOD=sequential
TIER3_NUM_KEYWORDS=0
TIER3_SELECTION_METHOD=sequential

CRAWL_PARALLEL_CRAWLERS=2
CRAWL_DELAY_MIN=0.5
CRAWL_DELAY_MAX=1.5
CRAWL_MAX_RETRIES=2

PIPELINE_CRAWL=true
PIPELINE_CLEAN=true
PIPELINE_IMPORT=false

ETL_CLEAN_BATCH_SIZE=10
ETL_MAX_THREADS=6
ETL_CONFIDENCE_THRESHOLD=0.0
SKIP_NORMALIZE=true
GEMINI_RPM=4
