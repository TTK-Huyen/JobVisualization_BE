# ============================================================================
# 🔑 API KEYS - Cách thêm key mới:
# ============================================================================
# 1. Thêm dòng: GEMINI_API_KEY_4=your_new_key (sau GEMINI_API_KEY_3)
# 2. Lưu file
# 3. Chạy lại - config tự động load
# 
# ❌ Không cần edit file config_api.py, không cần cập nhật bảng gì!
# ✅ Thêm key rồi .env, xóa key xóa dòng khỏi .env - vậy thôi!

GEMINI_API_KEY_1=AIzaSyDvs_IL30dtSvYq3MpdMinYkVC8ZYKeli8
GEMINI_API_KEY_2=AIzaSyDzyxb_E5fBOR2eudsAz-tVaHtP3wgd1YA
GEMINI_API_KEY_3=AIzaSyCJSgBzW6aDHGpczK7Kzt7zx2S0i04EnEU
# GEMINI_API_KEY_4=your_new_key_here  ← Bỏ comment # để thêm key mới

# Số key hiện đang dùng (0-based index)
# 0 = dùng GEMINI_API_KEY_1
# 1 = dùng GEMINI_API_KEY_2
# etc.
CURRENT_API_KEY_INDEX=0

# Model
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=5
GEMINI_RPD=20
GEMINI_TPM=250000

# ============================================================================
# 📊 JOB QUANTITY - Số lượng jobs crawl
# ============================================================================
# Cách thay đổi: chỉnh số ở đây hoặc edit trong config_jobs.py
# Mặc định đọc từ JOBS_QUANTITY_TABLE trong code
# Nếu set ở đây thì override lên

# TIER1_JOBS_PER_KEYWORD=10      # Main keywords (8 keywords)
# TIER2_JOBS_PER_KEYWORD=8       # Secondary keywords (2 keywords)
# TIER3_JOBS_PER_KEYWORD=5       # Occasional keywords

# Crawl settings
# CRAWL_PARALLEL_CRAWLERS=4
# CRAWL_DELAY_MIN=0.5
# CRAWL_DELAY_MAX=1.5
# CLEAN_BATCH_SIZE=20

# ============================================================================
# 🗄️ DATABASE - PostgreSQL
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
