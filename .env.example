# ============================================================================
# 📊 ETL PIPELINE CONFIGURATION (.env)
# ============================================================================
# 
# Tất cả cấu hình được load từ file này (override config_jobs.py)
# Để sử dụng: Đổi tên thành .env hoặc copy-paste vào .env hiện tại
#

# ============================================================================
# 1️⃣ JOBS PER KEYWORD
# ============================================================================
# Mỗi keyword sẽ crawl bao nhiêu jobs
JOBS_PER_KEYWORD=3

# ============================================================================
# 2️⃣ CRAWL SOURCES - Chọn sources nào sẽ crawl
# ============================================================================
# Giá trị > 0 = crawl, 0 = bỏ qua
# Ví dụ: CRAWL_CAREERVIET_JOBS=3 → Crawl careerviet, mỗi keyword 3 jobs
CRAWL_CAREERVIET_JOBS=0
CRAWL_ITVIEC_JOBS=0
CRAWL_LINKEDIN_JOBS=0
CRAWL_VIETNAMWORKS_JOBS=0

# ============================================================================
# 3️⃣ KEYWORD SELECTION - Chọn bao nhiêu keywords từ mỗi tier?
# ============================================================================

# TIER1 (8 keywords)
TIER1_NUM_KEYWORDS=1                    # Số keywords chọn
TIER1_SELECTION_METHOD=random           # "random" hoặc "sequential"

# TIER2 (5 keywords)
TIER2_NUM_KEYWORDS=0                    # 0 = skip tier2
TIER2_SELECTION_METHOD=sequential

# TIER3 (3 keywords)
TIER3_NUM_KEYWORDS=0                    # 0 = skip tier3
TIER3_SELECTION_METHOD=sequential

# ============================================================================
# 4️⃣ CRAWL SETTINGS (Tùy chọn)
# ============================================================================
CRAWL_PARALLEL_CRAWLERS=4               # Số crawler chạy song song
CRAWL_DELAY_MIN=0.5                     # Delay tối thiểu (giây)
CRAWL_DELAY_MAX=1.5                     # Delay tối đa (giây)
CRAWL_MAX_RETRIES=2                     # Retry lỗi lần số
CLEAN_BATCH_SIZE=20                     # Batch size cho cleaning

# ============================================================================
# 5️⃣ CLEANING SETTINGS
# ============================================================================
CLEAN_FUZZY_THRESHOLD=0.78              # Threshold cho fuzzy matching
CLEAN_USE_LLM=true                      # Dùng LLM cho skill extraction

# ============================================================================
# 6️⃣ API KEYS - Auto-rotate khi hết quota!
# ============================================================================
# Thêm bao nhiêu API key tùy ý (GEMINI_API_KEY_1, 2, 3, ...)
# System sẽ tự động rotate sang key khác khi key hiện tại hết quota
GEMINI_API_KEY_1=your_api_key_1
GEMINI_API_KEY_2=your_api_key_2
# GEMINI_API_KEY_3=your_api_key_3
# ...

# Thời gian cooldown (phút) khi key hết quota
API_KEY_COOLDOWN_MINUTES=15

# Model & Rate Limits (tùy chọn)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=5                # Requests per minute
GEMINI_RPD=20               # Requests per day
GEMINI_TPM=250000           # Tokens per minute

# ============================================================================
# 7️⃣ DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_db
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================================================
# 🎯 QUICK EXAMPLES
# ============================================================================

# Example 1: Quick Test (1 keyword, 3 jobs)
# CRAWL_CAREERVIET_JOBS=3
# TIER1_NUM_KEYWORDS=1
# JOBS_PER_KEYWORD=3
# Result: 1 keyword × 3 jobs = 3 jobs total

# Example 2: Medium Load (5 keywords, 5 jobs each, 2 sources)
# CRAWL_CAREERVIET_JOBS=5
# CRAWL_ITVIEC_JOBS=5
# TIER1_NUM_KEYWORDS=3
# TIER2_NUM_KEYWORDS=2
# JOBS_PER_KEYWORD=5
# Result: 5 keywords × (5 careerviet + 5 itviec) = 50 jobs total

# Example 3: Heavy Load (all tiers)
# CRAWL_CAREERVIET_JOBS=3
# CRAWL_ITVIEC_JOBS=3
# TIER1_NUM_KEYWORDS=3
# TIER2_NUM_KEYWORDS=2
# TIER3_NUM_KEYWORDS=1
# JOBS_PER_KEYWORD=3
# Result: (3+2+1) keywords × (3+3) jobs = 54 jobs total
